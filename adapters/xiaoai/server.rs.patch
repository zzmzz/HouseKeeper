 async fn on_event(event: Event) -> Result<(), AppError> {
     crate::pylog!("🔥 收到 Event: {:?}", event);
+    // 转发给 Python —— 官方 gemini 示例只打日志、不转发，
+    // 导致 Python 侧拿不到语音识别结果（只能拿音频流）。
+    // 我们要的是 xiaoai_asr 模式：复用小爱原生 ASR 的文本。
+    let payload = serde_json::to_string(&event).unwrap_or_default();
+    let data = Python::with_gil(|py| PyString::new(py, &payload).into());
+    let _ = PythonManager::instance().call_fn("on_event", Some(data));
     Ok(())
 }
